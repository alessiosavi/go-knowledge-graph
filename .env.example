# gkg configuration — copy to .env and fill in.
#   cp .env.example .env
#   make up
# Every gkg setting is the GKG_<SECTION>_<KEY> form of config.yaml; env
# overrides are documented here, defaults are shown.

# --- Compose wiring -------------------------------------------------------
MEMGRAPH_USER=gkg
# Required: generate one, e.g. openssl rand -hex 24
MEMGRAPH_PASSWORD=
# Host ports bind to 127.0.0.1.
MEMGRAPH_PORT=7687
GKG_PORT=8080
SIDECAR_PORT=8090
DOCLING_PORT=5001

# --- gkg connection (set automatically by compose; for standalone runs) ---
# GKG_MEMGRAPH_URI=bolt://localhost:7687
# GKG_MEMGRAPH_USER=gkg
# GKG_MEMGRAPH_PASSWORD=
GKG_SERVER_ADDR=:8080

# Required: the edge sends it to gkg as the bearer (users never see it);
# also required for direct REST/MCP calls. Generate: openssl rand -hex 32
# (letters, digits and . _ ~ + / = - only; 16-256 characters).
GKG_API_KEY=

# --- Edge (nginx + ModSecurity; the only service reachable beyond loopback) --
# Users authenticate with basic auth: make passwd LOGIN=<name> writes
# deploy/edge/htpasswd (untracked). Only the UI, the REST routes it uses and
# /mcp are exposed; everything else is a 404 behind the password.
# Bind address: loopback here; the EC2 box sets 0.0.0.0.
EDGE_BIND=127.0.0.1
# EDGE_HTTP_PORT=80
# EDGE_HTTPS_PORT=443
# Public DNS name on the box (make cert issues for it); localhost locally.
# EDGE_SERVER_NAME=localhost
# HSTS max-age in seconds: 0 locally; 31536000 on the box once the
# certificate is real.
# EDGE_HSTS_MAX_AGE=0
# Proxy read timeouts: ingest = fetch 30 + converter 300 + 60; ask = agent 60 + 30.
# EDGE_INGEST_TIMEOUT_S=390
# EDGE_ASK_TIMEOUT_S=90

# --- Extractor (default: local GLiNEREL sidecar) ----------------------
GKG_EXTRACTOR_MODE=sidecar
GKG_EXTRACTOR_OPENAI_BASE_URL=https://api.openai.com/v1
GKG_EXTRACTOR_OPENAI_API_KEY=
GKG_EXTRACTOR_OPENAI_MODEL=deepseek-v4.1-flash

# --- Local extraction (started by make up) --------------------------------
# GLINEREL_MODEL selects the baked checkpoint (314m default, 72m smaller).
# Change it, then run make build S=sidecar && make up.
# Leave both GKG_EXTRACTOR_SIDECAR_URL and GKG_CONVERTER_URL unset:
# compose wires service names; a host-run binary defaults to localhost.
# GKG_EXTRACTOR_SIDECAR_URL=http://sidecar:8090
GKG_EXTRACTOR_SIDECAR_MODEL=glinerel-314m
# Includes queueing behind other workers' serialized inference (4 by default).
GKG_EXTRACTOR_SIDECAR_TIMEOUT_S=300
GLINEREL_MODEL=314m

# Light mode (make up LIGHT=1) skips both model services.
# GKG_LIGHT_EXTRACTOR_MODE=mock

# --- Optional entity embeddings (search vector leg) -----------------------
# Provider: "" / openai = any OpenAI-compatible /embeddings endpoint;
# furls = the asymmetric embeddings service (separate document and query
# Function URLs, 768d, shared x-api-key). With furls, the service's own
# variables are read from .env (non-empty values only) — put the values
# there and never in the repo:
#   EMBED_QUERY_FURL=<embed_query Function URL>
#   EMBED_PRODUCT_FURL=<embed_product Function URL>
#   EMBED_API_KEY=<shared secret>
GKG_EMBEDDER_ENABLED=false
GKG_EMBEDDER_PROVIDER=
GKG_EMBEDDER_BASE_URL=https://api.openai.com/v1
GKG_EMBEDDER_API_KEY=
# Empty = provider default (openai: text-embedding-3-small; furls accepts
# only empty or gemini-embedding-2 and fails fast otherwise).
GKG_EMBEDDER_MODEL=
GKG_EMBEDDER_DIM=768
EMBED_QUERY_FURL=
EMBED_PRODUCT_FURL=
EMBED_API_KEY=
# Entries per FURL request (empty = one request per pipeline batch; chunks
# are dispatched concurrently). The service accepts up to 128 per request.
EMBED_BATCH_SIZE=

# --- Optional online fact judge (off by default) --------------------------
GKG_JUDGE_MODE=off
GKG_JUDGE_BASE_URL=https://api.openai.com/v1
GKG_JUDGE_API_KEY=
GKG_JUDGE_MODEL=deepseek-v4.1-flash
GKG_JUDGE_VERIFY_FLOOR=0.35
GKG_JUDGE_SAMPLE_PCT=10

# --- Optional "Ask the graph" agent (off by default) ----------------------
# A server-side, read-only LLM agent behind POST /v1/agent/ask and
# POST /v1/agent/ask/stream (SSE: tool/delta/done events), mounted on
# the serve surface (same bearer policy as the API). It answers questions by
# running the same read-only tools as MCP and returns the raw tool results
# as evidence; while disabled the endpoint answers 501 and the web UI hides
# its ask panel. Provider cost and latency apply to every ask.
GKG_AGENT_ENABLED=false
GKG_AGENT_BASE_URL=https://api.openai.com/v1
GKG_AGENT_API_KEY=
GKG_AGENT_MODEL=deepseek-v4.1-flash
# Model turns that may request tools per ask (default 6; each turn may run
# up to 8 tool calls). The ask also runs under GKG_AGENT_TIMEOUT_S.
GKG_AGENT_MAX_STEPS=6
GKG_AGENT_TIMEOUT_S=60
# Stream provider responses (default true): progressive answer fragments on
# the SSE endpoint. A provider without streaming support is detected
# automatically and the agent falls back to non-streamed answers.
GKG_AGENT_STREAM=true

# --- Ingest tuning (defaults) ---------------------------------------------
# Standalone default: $HOME/.local/share/gkg/ingest-spool. Compose fixes this
# to /var/lib/gkg/ingest-spool on the gkg-data named volume.
# GKG_INGEST_SPOOL_DIR=
# Converted payloads awaiting durable chunks: cap exhaustion returns 503
# with Retry-After: 30. Byte cap counts serialized payloads, not raw uploads.
GKG_INGEST_SPOOL_MAX_COUNT=1024
GKG_INGEST_SPOOL_MAX_BYTES=1073741824
GKG_INGEST_MAX_UPLOAD_MB=20
GKG_INGEST_MAX_URL_MB=10
GKG_INGEST_MAX_CHUNKS=2000
GKG_INGEST_STORE_FLOOR=0.15
GKG_INGEST_ASSERT_FLOOR=0.50
GKG_INGEST_CHUNK_WORDS=200
GKG_INGEST_OVERLAP_SENTENCES=1
GKG_INGEST_CHUNK_DEDUP=near
GKG_INGEST_JACCARD_THRESHOLD=0.85
GKG_INGEST_FETCH_TIMEOUT_S=30
GKG_INGEST_MAX_REDIRECTS=5

# --- Read-only cypher surface (defaults) ----------------------------------
GKG_LIMITS_CYPHER_ROWS=1000
GKG_LIMITS_CYPHER_TIMEOUT_MS=10000

# --- High-quality document conversion (default: docling) ------------------
# GKG_CONVERTER_MODE=docling routes PDF/Office inputs through the
# docling-serve sidecar (started by make up, loopback port 5001) and
# feeds its markdown into the existing pipeline. A conversion failure fails
# the document; there is no silent fallback to the best-effort PDF path.
GKG_CONVERTER_MODE=docling
# Images convert by default; false refuses images before contacting docling.
# GKG_CONVERTER_IMAGES=true
# Tesseract is the default OCR engine; the docling image ships English OCR data only.
# GKG_CONVERTER_OCR_ENGINE=tesseract
# Refuse images above this megapixel cap; raise only on a bigger-memory machine.
# GKG_CONVERTER_MAX_IMAGE_MP=12.5
# GKG_CONVERTER_URL=http://docling:5001
GKG_CONVERTER_API_KEY=
GKG_CONVERTER_TIMEOUT_S=300
GKG_CONVERTER_MAX_RESPONSE_MB=32
# docling-serve sidecar; set to require X-Api-Key:
DOCLING_API_KEY=
# DOCLING_ENG_WORKERS=2
# DOCLING_NUM_THREADS=4
# DOCLING_DEVICE=

# --- Labels ---------------------------------------------------------------
# Preset YAMLs shipped: general.yaml, news.yaml (see labels/).
GKG_LABELS_PRESETS_DIR=labels
