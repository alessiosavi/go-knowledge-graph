# Data only: unquoted KEY=value, no shell expansion. Copy to box.env (0600).
AWS_PROFILE=example
AWS_REGION=eu-west-1
EXPECTED_ACCOUNT=123456789012
VPC_ID=vpc-0example
SUBNET_ID=subnet-example
NAME=gkg
HOSTNAME=gkg.example.com
# Leave empty for manual DNS at your domain provider; otherwise set a Route 53 zone.
HOSTED_ZONE_ID=
INSTANCE_TYPE=t3a.xlarge
DISK_GB=100
REPO_URL=https://github.com/example/go-knowledge-graph.git
