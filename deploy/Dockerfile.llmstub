# syntax=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b
# Same base references as Dockerfile.gkg; no external Go dependencies.
FROM golang:1.27.4-alpine@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS build
WORKDIR /src
COPY scripts/llmstub/main.go ./main.go
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/llmstub main.go

FROM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
RUN adduser -D -u 10001 stub
COPY --from=build /out/llmstub /usr/local/bin/llmstub
USER stub
EXPOSE 8099
ENTRYPOINT ["llmstub"]
