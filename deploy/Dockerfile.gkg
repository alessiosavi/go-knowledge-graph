# gkg service image: static Go binary on a minimal base with CA
# certificates (URL ingestion fetches https) and busybox wget for the
# compose healthcheck.
# syntax=docker/dockerfile:1

FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/gkg ./cmd/gkg

FROM alpine:3.20
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 gkg
# A fresh named volume inherits this ownership before USER takes effect.
RUN mkdir -p /var/lib/gkg/ingest-spool && chown -R gkg:gkg /var/lib/gkg
COPY --from=build /out/gkg /usr/local/bin/gkg
USER gkg
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=20s \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["gkg"]
CMD ["serve"]
